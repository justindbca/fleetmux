 "page_commands_description": "M4 (PROTOCOL.md §4.23-§4.26): the four page commands, listed apart from the 22 commands above as proto::page_commands() is apart from proto::known_commands(); only a server whose hello reply has pages:1 knows them. bad_request (including \"no such page: <id>\") and internal apply as to every command; M4 adds no error code.",
 "page_commands": {
  "page.open": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "page"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "page.open"
     },
     "page": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "a page id (proto::valid_page_id); the root page is \"\""
     },
     "title": {
      "type": "string",
      "description": "absent: the id on create, unchanged otherwise"
     },
     "reclaimed": {
      "type": "boolean",
      "default": false
     },
     "history_url": {
      "type": "string",
      "description": "sets that page's kv history_url"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     }
    }
   },
   "errors": [],
   "examples": [
    {
     "request": {
      "id": 23,
      "cmd": "page.open",
      "page": "M0",
      "title": "M0 build"
     },
     "response": {
      "id": 23,
      "ok": true
     }
    }
   ]
  },
  "page.close": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "page"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "page.close"
     },
     "page": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "a page id (proto::valid_page_id); the root page is \"\""
     },
     "keep": {
      "type": "boolean",
      "default": true,
      "description": "true: the page becomes reclaimed and stays; false: it is removed"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     }
    }
   },
   "errors": [
    "not_empty"
   ],
   "examples": [
    {
     "request": {
      "id": 24,
      "cmd": "page.close",
      "page": "M0"
     },
     "response": {
      "id": 24,
      "ok": false,
      "code": "not_empty",
      "error": "page.close: page \"M0\" still has 2 panes"
     }
    }
   ]
  },
  "page.select": {
   "request": {
    "type": "object",
    "required": [
     "id",
