 "view": {
  "version": 1,
  "max_frame_payload": 1048576,
  "max_web_frame_payload": 33554432,
  "hello": {
   "type": "object",
   "required": [
    "view",
    "cols",
    "rows",
    "term",
    "colorterm"
   ],
   "properties": {
    "view": {
     "const": 1
    },
    "cols": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65535
    },
    "rows": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65535
    },
    "term": {
     "type": "string"
    },
    "colorterm": {
     "type": "string"
    },
    "overlay": {
     "description": "M2.6, optional: integer 1 = this connection wants 0x85 overlay frames; key absent or integer 0 = it does not; any other value, explicit null included (exception to the null-as-absent rule), = bad_request (PROTOCOL.md §6.1)",
     "type": "integer",
     "enum": [
      0,
      1
     ]
    }
   }
  },
  "hello_reply": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "ok",
      "epoch",
      "protocol"
     ],
     "properties": {
      "ok": {
       "const": true
      },
      "epoch": {
       "$ref": "#/$defs/epoch"
      },
      "protocol": {
       "type": "integer"
      },
      "pages": {
       "const": 1,
       "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: the server knows pages (0x04 jump event, page.select redraws); absent = an M3 server"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "ok",
      "code",
      "error"
     ],
     "properties": {
      "ok": {
       "const": false
      },
      "code": {
       "enum": [
