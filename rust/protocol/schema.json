{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/justindbca/fleetmux/blob/main/rust/protocol/schema.json",
 "title": "fleetmux control protocol",
 "description": "Machine-readable twin of rust/PROTOCOL.md §1-§6. Every command has request / response schemas, the command-specific error codes (bad_request and internal apply to every command) and examples copied from PROTOCOL.md §4. crates/proto/tests/codec.rs decodes every example and checks that the command names here equal the codec's list.",
 "protocol": 1,
 "max_line_bytes": 4194304,
 "error_codes": [
  "bad_request",
  "unknown_cmd",
  "no_such_pane",
  "unknown_key",
  "unknown_type",
  "not_empty",
  "spawn_failed",
  "kill_timeout",
  "write_failed",
  "protocol_version",
  "internal",
  "no_window",
  "web_timeout",
  "not_implemented"
 ],
 "common_errors": [
  "bad_request",
  "internal"
 ],
 "$defs": {
  "request_id": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "epoch": {
   "type": "string",
   "pattern": "^[0-9a-z]{4}$"
  },
  "pane_id": {
   "type": "string",
   "pattern": "^[0-9a-z]{4}-[1-9][0-9]*$"
  },
  "group": {
   "enum": [
    "supervisor",
    "lower",
    "workers"
   ]
  },
  "write_mode": {
   "enum": [
    "raw",
    "bracketed",
    "paste"
   ]
  },
  "base64": {
   "type": "string",
   "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
  },
  "pane_record": {
   "type": "object",
   "required": [
    "pane",
    "title",
    "type",
    "group",
    "index",
    "pid",
    "pgid",
    "tty",
    "cols",
    "rows",
    "focused"
   ],
   "properties": {
    "pane": {
     "$ref": "#/$defs/pane_id"
    },
    "title": {
     "type": "string"
    },
    "type": {
     "type": "string"
    },
    "group": {
     "$ref": "#/$defs/group"
    },
    "index": {
     "type": "integer",
     "minimum": 0
    },
    "pid": {
     "type": "integer"
    },
    "pgid": {
     "type": "integer"
    },
    "tty": {
     "type": "string"
    },
    "cols": {
     "type": "integer",
     "minimum": 1
    },
    "rows": {
     "type": "integer",
     "minimum": 1
    },
    "focused": {
     "type": "boolean"
    },
    "unseen": {
     "type": "boolean",
     "default": false,
     "description": "optional (stage A P-2): output arrived while not displayed; absent = false"
    },
    "scrollback": {
     "type": "integer",
     "minimum": 0,
     "default": 0,
     "description": "optional (stage A P-2): current scrollback rows; absent = 0"
    },
    "page": {
     "type": "string",
     "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: the pane's page, \"\" = the root page; see PROTOCOL.md §4.5 for when it is present"
    },
    "fg_pgid": {
     "type": [
      "integer",
      "null"
     ],
     "description": "optional (PROTOCOL.md §2 addendum 2026-11-08, §4.0): the PTY's foreground process group when the reply was built; = pgid while the pane's program holds the terminal (a shell idle at its prompt), null when the PTY reports none; absent or null = not known to be idle"
    }
   }
  },
  "layout": {
   "type": "object",
   "required": [
    "h_ratio",
    "v_ratio",
    "zoom",
    "focus",
    "groups",
    "selected"
   ],
   "properties": {
    "h_ratio": {
     "type": "integer",
     "minimum": 10,
     "maximum": 90
    },
    "v_ratio": {
     "type": "integer",
     "minimum": 10,
     "maximum": 90
    },
    "zoom": {
     "oneOf": [
      {
       "$ref": "#/$defs/pane_id"
      },
      {
       "type": "null"
      }
     ]
    },
    "focus": {
     "$ref": "#/$defs/group"
    },
    "groups": {
     "type": "object",
     "required": [
      "supervisor",
      "lower",
      "workers"
     ],
     "additionalProperties": false,
     "properties": {
      "supervisor": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/pane_id"
       }
      },
      "lower": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/pane_id"
       }
      },
      "workers": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/pane_id"
       }
      }
     }
    },
    "selected": {
     "type": "object",
     "required": [
      "supervisor",
      "lower",
      "workers"
     ],
     "additionalProperties": false,
     "properties": {
      "supervisor": {
       "oneOf": [
        {
         "$ref": "#/$defs/pane_id"
        },
        {
         "type": "null"
        }
       ]
      },
      "lower": {
       "oneOf": [
        {
         "$ref": "#/$defs/pane_id"
        },
        {
         "type": "null"
        }
       ]
      },
      "workers": {
       "oneOf": [
        {
         "$ref": "#/$defs/pane_id"
        },
        {
         "type": "null"
        }
       ]
      }
     }
    }
   }
  },
  "error_reply": {
   "type": "object",
   "required": [
    "id",
    "ok",
    "code",
    "error"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "oneOf": [
      {
       "$ref": "#/$defs/request_id"
      },
      {
       "type": "null"
      }
     ]
    },
    "ok": {
     "const": false
    },
    "code": {
     "enum": [
      "bad_request",
      "unknown_cmd",
      "no_such_pane",
      "unknown_key",
      "unknown_type",
      "not_empty",
      "spawn_failed",
      "kill_timeout",
      "write_failed",
      "protocol_version",
      "internal"
     ]
    },
    "error": {
     "type": "string"
    }
   }
  }
 },
 "commands": {
  "hello": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "hello"
     },
     "protocol": {
      "type": "integer"
     },
     "page": {
      "type": [
       "string",
       "null"
      ],
      "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: a page id (§4.23) binds this connection to that page; absent / null / \"\" = no binding (the root page)"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok",
     "uid",
     "pid",
     "epoch",
     "version",
     "protocol",
     "run"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     },
     "uid": {
      "type": "integer"
     },
     "pid": {
      "type": "integer"
     },
     "epoch": {
      "$ref": "#/$defs/epoch"
     },
     "version": {
      "type": "string"
     },
     "protocol": {
      "type": "integer"
     },
     "run": {
      "type": [
       "string",
       "null"
      ]
     },
     "viewers": {
      "type": "integer",
      "minimum": 0,
      "description": "optional (stage A P-3): open view connections"
     },
     "prefix": {
      "type": "string",
      "default": "C-b",
      "description": "optional (stage A P-3): the server's prefix key name"
     },
     "pages": {
      "const": 1,
      "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: the capability key; a server that sends it knows the page commands (page_commands below)"
     },
     "page": {
      "type": "string",
      "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: this connection's page, \"\" = not bound (the root page)"
     },
     "current": {
      "type": "string",
      "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: the current page of every viewer, \"\" = the root page"
     }
    }
   },
   "errors": [
    "protocol_version"
   ],
   "examples": [
    {
     "request": {
      "id": 1,
      "cmd": "hello",
      "protocol": 1
     },
     "response": {
      "id": 1,
      "ok": true,
      "uid": 501,
      "pid": 4242,
      "epoch": "k7q2",
      "version": "0.1.0",
      "protocol": 1,
      "run": null
     }
    },
    {
     "request": {
      "id": 1,
      "cmd": "hello"
     },
     "response": {
      "id": 1,
      "ok": true,
      "uid": 501,
      "pid": 4242,
      "epoch": "k7q2",
      "version": "0.1.0",
      "protocol": 1,
      "run": "fleet-20261028-095326-d346b75c",
      "viewers": 1,
      "prefix": "C-b"
     }
    }
   ]
  },
  "kv.set": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "key",
     "value"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "kv.set"
     },
     "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     },
     "value": {
      "type": "string",
      "maxLength": 65536
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     }
    }
   },
   "errors": [],
   "examples": [
    {
     "request": {
      "id": 2,
      "cmd": "kv.set",
      "key": "run",
      "value": "fleet-20261028-095326-d346b75c"
     },
     "response": {
      "id": 2,
      "ok": true
     }
    }
   ]
  },
  "kv.get": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "key"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "kv.get"
     },
     "key": {
      "type": "string"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok",
     "value"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     },
     "value": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "errors": [],
   "examples": [
    {
     "request": {
      "id": 3,
      "cmd": "kv.get",
      "key": "run"
     },
     "response": {
      "id": 3,
      "ok": true,
      "value": "fleet-20261028-095326-d346b75c"
     }
    }
   ]
  },
  "pane.spawn": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "argv"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.spawn"
     },
     "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     },
     "cwd": {
      "type": "string"
     },
     "env": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "title": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "group": {
      "$ref": "#/$defs/group"
     },
     "anchor": {
      "$ref": "#/$defs/pane_id"
     },
     "before": {
      "type": "boolean"
     },
     "page": {
      "type": "string",
      "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: spawn into this existing page (absent = the connection's page); an unknown page is bad_request \"no such page: <id>\""
     }
    },
    "dependentRequired": {
     "before": [
      "anchor"
     ]
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok",
     "pane",
     "pid",
     "pgid",
     "tty"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     },
     "pane": {
      "$ref": "#/$defs/pane_id"
     },
     "pid": {
      "type": "integer"
     },
     "pgid": {
      "type": "integer"
     },
     "tty": {
      "type": "string"
     }
    }
   },
   "errors": [
    "spawn_failed",
    "unknown_type",
    "no_such_pane"
   ],
   "examples": [
    {
     "request": {
      "id": 4,
      "cmd": "pane.spawn",
      "argv": [
       "bash",
       "-lc",
       "cd /w && exec claude"
      ],
      "cwd": "/w",
      "env": {
       "FLEET_SLOT": "worker-1"
      },
      "title": "fx-worker-1",
      "type": "worker"
     },
     "response": {
      "id": 4,
      "ok": true,
      "pane": "k7q2-12",
      "pid": 5151,
      "pgid": 5151,
      "tty": "/dev/ttys012"
     }
    }
   ]
  },
  "pane.list": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.list"
     },
     "all": {
      "type": "boolean",
      "default": false,
      "description": "M4 (PROTOCOL.md §2 addendum, design m4 §4.2), optional: true lists the panes of every page (absent = only the connection's page)"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok",
     "panes"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     },
     "panes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/pane_record"
      }
     }
    }
   },
   "errors": [],
   "examples": [
    {
     "request": {
      "id": 5,
      "cmd": "pane.list"
     },
     "response": {
      "id": 5,
      "ok": true,
      "panes": [
       {
        "pane": "k7q2-1",
        "title": "fx-supervisor-1",
        "type": "supervisor",
        "group": "supervisor",
        "index": 0,
        "pid": 5001,
        "pgid": 5001,
        "tty": "/dev/ttys004",
        "cols": 118,
        "rows": 34,
        "focused": true
       }
      ]
     }
    }
   ]
  },
  "pane.get": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "pane"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.get"
     },
     "pane": {
      "$ref": "#/$defs/pane_id"
     }
    }
   },
   "response": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "id",
       "ok"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/request_id"
       },
       "ok": {
        "const": true
       }
      }
     },
     {
      "$ref": "#/$defs/pane_record"
     }
    ]
   },
   "errors": [
    "no_such_pane"
   ],
   "examples": [
    {
     "request": {
      "id": 6,
      "cmd": "pane.get",
      "pane": "k7q2-12"
     },
     "response": {
      "id": 6,
      "ok": true,
      "pane": "k7q2-12",
      "title": "fx-worker-1",
      "type": "worker",
      "group": "workers",
      "index": 0,
      "pid": 5151,
      "pgid": 5151,
      "tty": "/dev/ttys012",
      "cols": 119,
      "rows": 57,
      "focused": false
     }
    }
   ]
  },
  "pane.write": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "pane",
     "data",
     "mode"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.write"
     },
     "pane": {
      "$ref": "#/$defs/pane_id"
     },
     "data": {
      "$ref": "#/$defs/base64"
     },
     "mode": {
      "$ref": "#/$defs/write_mode"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok",
     "written"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     },
     "written": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "errors": [
    "no_such_pane",
    "unknown_type",
    "write_failed"
   ],
   "examples": [
    {
     "request": {
      "id": 7,
      "cmd": "pane.write",
      "pane": "k7q2-12",
      "data": "LS1oZWxwCg==",
      "mode": "bracketed"
     },
     "response": {
      "id": 7,
      "ok": true,
      "written": 7
     }
    }
   ]
  },
  "pane.key": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "pane",
     "key"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.key"
     },
     "pane": {
      "$ref": "#/$defs/pane_id"
     },
     "key": {
      "type": "string"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     }
    }
   },
   "errors": [
    "no_such_pane",
    "unknown_key",
    "write_failed"
   ],
   "examples": [
    {
     "request": {
      "id": 8,
      "cmd": "pane.key",
      "pane": "k7q2-12",
      "key": "Enter"
     },
     "response": {
      "id": 8,
      "ok": true
     }
    }
   ]
  },
  "pane.read": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "pane",
     "lines"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.read"
     },
     "pane": {
      "$ref": "#/$defs/pane_id"
     },
     "lines": {
      "type": "integer",
      "minimum": 1
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok",
     "text"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     },
     "text": {
      "type": "string",
      "description": "last `lines` physical rows of scrollback + screen, each with trailing blanks stripped, no row dropped (blank rows come back empty), joined by \\n, no \\n after the last row"
     }
    }
   },
   "errors": [
    "no_such_pane"
   ],
   "examples": [
    {
     "request": {
      "id": 9,
      "cmd": "pane.read",
      "pane": "k7q2-12",
      "lines": 4
     },
     "response": {
      "id": 9,
      "ok": true,
      "text": "$ echo hi\nhi\n$\n"
     }
    }
   ]
  },
  "pane.rename": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "pane",
     "title"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "cmd": {
      "const": "pane.rename"
     },
     "pane": {
      "$ref": "#/$defs/pane_id"
     },
     "title": {
      "type": "string"
     }
    }
   },
   "response": {
    "type": "object",
    "required": [
     "id",
     "ok"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/request_id"
     },
     "ok": {
      "const": true
     }
    }
   },
   "errors": [
    "no_such_pane"
   ],
   "examples": [
    {
     "request": {
      "id": 10,
      "cmd": "pane.rename",
      "pane": "k7q2-12",
      "title": "fx-worker-1.1"
     },
     "response": {
      "id": 10,
      "ok": true
     }
    }
   ]
  },
  "pane.focus": {
   "request": {
    "type": "object",
    "required": [
     "id",
     "cmd",
     "pane"
    ],
